# Copy to .env.local and fill in real values.
#
# docs/AGENTS.md's "Environment Variables" section only lists
# NEXT_PUBLIC_API_URL and NEXT_PUBLIC_ADMIN_EMAIL -- the three Supabase/site
# vars below are also read directly in code (lib/supabase.ts, lib/siteConfig.ts)
# but aren't in that doc yet. Listed here to match what the app actually
# needs to run; AGENTS.md should get the same update (see P3-08).

NEXT_PUBLIC_API_URL=                # backend API base URL, e.g. http://localhost:3001
NEXT_PUBLIC_ADMIN_EMAIL=            # UI-only convenience check to show/hide the admin nav link -- real enforcement is server-side (backend ADMIN_EMAIL)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # anon/public key, safe to expose client-side -- not the service role key

NEXT_PUBLIC_SITE_URL=               # absolute site origin used for canonical links, OG tags, sitemap.ts, and robots.ts -- falls back to the Vercel prod URL if unset (see lib/siteConfig.ts)
